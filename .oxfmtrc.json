{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "ignorePatterns": [
    "/pnpm-lock.yaml",
    "/design-tokens",
    "/dist",
    "/coverage",
    "/.nx/cache",
    "/.nx/workspace-data",
    "*.generated.ts",
    "*.generated.tsx",
    "*.mdx",
    "/@kv-designsystem/css/src/components.css",
    "/@kv-designsystem/theme/dist"
  ]
}
