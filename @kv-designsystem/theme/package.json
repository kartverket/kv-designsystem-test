{
  "name": "@kv-designsystem/theme",
  "repository": {
    "type": "git",
    "url": "github:kartverket/kv-designsystem-test",
    "directory": "@kv-designsystem/theme"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "license": "MIT",
  "version": "1.0.0-alpha.2",
  "type": "module",
  "exports": {
    "./types": "./dist/types.d.ts",
    "./green": {
      "types": "./dist/types.d.ts",
      "default": "./dist/green.css"
    },
    "./blue": {
      "types": "./dist/types.d.ts",
      "default": "./dist/blue.css"
    },
    "./tailwind": "./dist/tailwind.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@digdir/designsystemet-types": "catalog:"
  },
  "devDependencies": {
    "@internal/build-tools": "workspace:*",
    "@kv-designsystem/tokens": "workspace:*",
    "rimraf": "catalog:"
  },
  "scripts": {
    "copy-css": "cp ../../design-tokens/dist/*.* ./dist/ && rm ./dist/colors.d.ts ./dist/blue.tailwind.css && mv ./dist/green.tailwind.css ./dist/tailwind.css",
    "clean": "rimraf ./dist && mkdir ./dist",
    "build": "pnpm clean && pnpm copy-css"
  }
}
