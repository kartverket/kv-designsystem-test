{
  "name": "@kv-designsystem/react",
  "version": "1.0.0-alpha.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:kartverket/kv-designsystem-test",
    "directory": "@kv-designsystem/react"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/alpha.js",
  "types": "./dist/alpha.d.ts",
  "exports": {
    ".": {
      "import": "./dist/alpha.js",
      "require": "./dist/alpha.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts"
    },
    "./green": {
      "types": "./dist/style/css-import.d.ts",
      "default": "./dist/style/green.css"
    },
    "./blue": {
      "types": "./dist/style/css-import.d.ts",
      "default": "./dist/style/blue.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format:check": "pnpm exec oxfmt --check .",
    "generate-layout-tokens": "node scripts/generate-layout-tokens-css.ts",
    "generate-description-list-breakpoints": "node scripts/generate-description-list-breakpoints-css.ts",
    "lint": "oxlint --type-aware --max-warnings 0",
    "lint-circular-dependencies": "pnpm madge --circular ./src/alpha.ts",
    "lint-mdx-controls": "node ./scripts/check-mdx-controls.ts",
    "typecheck": "tsgo --build",
    "build": "vite build && cp ../../@internal/build-tools/css-import.d.ts dist/style/css-import.d.ts",
    "dev": "storybook dev --port 6006 --ci",
    "preview": "vite preview",
    "build-storybook": "pnpm nx build @kv-designsystem/css && storybook build --stats-json",
    "test-storybook": "pnpm nx test --project=storybook",
    "view-storybook-test-report": "pnpm dlx http-server ./test-reports/storybook"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "catalog:",
    "@digdir/designsystemet-react": "catalog:",
    "@digdir/designsystemet-types": "catalog:",
    "@kv-designsystem/css": "workspace:*",
    "@kv-designsystem/theme": "workspace:*",
    "@navikt/aksel-icons": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "clsx": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@internal/build-tools": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/ramda": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "nx": "catalog:",
    "playwright": "catalog:",
    "ramda": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^18.3.7 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
