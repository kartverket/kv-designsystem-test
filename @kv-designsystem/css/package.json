{
  "name": "@kv-designsystem/css",
  "version": "1.0.0-alpha.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:kartverket/kv-designsystem-test",
    "directory": "@kv-designsystem/css"
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "exports": {
    "./green": {
      "types": "./dist/css-import.d.ts",
      "default": "./dist/green.css"
    },
    "./blue": {
      "types": "./dist/css-import.d.ts",
      "default": "./dist/blue.css"
    },
    "./tailwind": {
      "types": "./dist/css-import.d.ts",
      "default": "./dist/tailwind.css"
    },
    "./components.css": "./dist/components.css"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "pnpm nx run @kv-designsystem/css:build",
    "format:check": "pnpm exec oxfmt --check .",
    "generate-components-css": "pnpm nx run @kv-designsystem/css:generate-components-css",
    "lint": "oxlint --max-warnings 0",
    "typecheck": "tsgo --build",
    "watch": "pnpm build --watch"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "catalog:",
    "@kv-designsystem/theme": "workspace:*"
  },
  "devDependencies": {
    "@internal/build-tools": "workspace:*",
    "autoprefixer": "catalog:",
    "cssnano": "catalog:",
    "postcss": "catalog:",
    "postcss-cli": "catalog:",
    "postcss-import": "catalog:",
    "postcss-load-config": "catalog:",
    "postcss-nesting": "catalog:"
  }
}
