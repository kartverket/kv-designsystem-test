{
  "name": "@kv-designsystem/css",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "@kv-designsystem/css/src",
  "projectType": "library",
  "tags": [],
  "namedInputs": {
    "css": [
      "{workspaceRoot}/@kv-designsystem/react/src/components/**/*.css",
      "!{workspaceRoot}/@kv-designsystem/react/src/components/**/*.module.css",
      "{workspaceRoot}/@kv-designsystem/react/src/components/layout/layoutTokens.ts",
      "{workspaceRoot}/@kv-designsystem/react/scripts/generate-layout-tokens-css.ts"
    ]
  },
  "targets": {
    "generate-components-css": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["css", "default", "^default"],
      "outputs": ["{projectRoot}/src/components.css"],
      "dependsOn": [
        {
          "projects": ["@kv-designsystem/react"],
          "target": "generate-layout-tokens"
        }
      ],
      "options": {
        "command": "node scripts/generate-components-css.ts",
        "cwd": "@kv-designsystem/css"
      }
    },
    "build": {
      "cache": true,
      "inputs": ["css", "default", "^default"],
      "dependsOn": [
        "lint",
        "format:check",
        "generate-components-css",
        "^build",
        "^install-dependencies"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "postcss \"src/*.css\" --base src --dir dist && cp ../../@internal/build-tools/css-import.d.ts dist/css-import.d.ts",
        "cwd": "@kv-designsystem/css"
      }
    },
    "watch": {
      "continuous": true,
      "inputs": ["css", "default", "^default"]
    }
  }
}
