{
  "$schema": "https://designsystemet.no/schemas/config/1.24.0.json",
  "output": [
    {
      "type": "design-tokens",
      "dir": "./src",
      "cleanDir": true
    },
    {
      "type": "css",
      "dir": "./dist",
      "cleanDir": true,
      "tailwind": "v3"
    },
    {
      "type": "types",
      "dir": "./dist",
      "cleanDir": true
    }
  ],
  "themes": {
    "green": {
      "colors": {
        "accent": "#1a833b",
        "support-1": "#fa782d",
        "support-2": "#8c4799",
        "neutral": "#171717"
      },
      "overrides": {
        "severity": {
          "info": "#439ccd",
          "success": "#3AA426",
          "warning": "#ffc600",
          "danger": "#d72800"
        }
      },
      "borderRadius": 4
    },
    "blue": {
      "colors": {
        "accent": "#1A589F",
        "support-1": "#fa782d",
        "support-2": "#8c4799",
        "neutral": "#171717"
      },
      "overrides": {
        "severity": {
          "info": "#439ccd",
          "success": "#3AA426",
          "warning": "#ffc600",
          "danger": "#d72800"
        }
      },
      "borderRadius": 4
    }
  }
}
