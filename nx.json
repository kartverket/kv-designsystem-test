{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultProject": "@kv-designsystem/react",
  "release": {
    "projects": ["@kv-designsystem/react", "@kv-designsystem/theme", "@kv-designsystem/css"],
    "projectsRelationship": "fixed",
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "renderOptions": {
          "authors": false
        }
      }
    },
    "version": {
      "conventionalCommits": true
    }
  },
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["default", "^default"],
      "dependsOn": ["generate-layout-tokens", "generate-components-css", "^build"],
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/oxlint.config.ts",
        { "externalDependencies": ["oxlint", "oxlint-tsgolint"] }
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint-circular-dependencies": {
      "cache": true
    },
    "lint-mdx-controls": {
      "cache": true
    },
    "generate-layout-tokens": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/generate-layout-tokens-css.ts",
        "{projectRoot}/src/components/layout/layoutTokens.ts",
        "sharedGlobals"
      ],
      "outputs": ["{projectRoot}/src/components/layout/layoutTokens.generated.css"]
    },
    "generate-components-css": {
      "cache": true,
      "inputs": ["css", "{projectRoot}/scripts/generate-components-css.ts", "sharedGlobals"],
      "outputs": ["{projectRoot}/src/components.css"],
      "dependsOn": [
        {
          "projects": ["@kv-designsystem/react"],
          "target": "generate-layout-tokens"
        }
      ]
    },
    "test-storybook": {
      "outputs": ["{projectRoot}/test-reports/storybook"],
      "cache": true,
      "dependsOn": ["build"]
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/build.yml",
      "{workspaceRoot}/.github/actions/setup/action.yml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "analytics": false
}
