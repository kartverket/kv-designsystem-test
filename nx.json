{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultProject": "@kv-designsystem/react",
  "release": {
    "projects": ["@kv-designsystem/react", "@kv-designsystem/theme", "@kv-designsystem/css"],
    "projectsRelationship": "fixed",
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "renderOptions": {
          "authors": false
        }
      }
    },
    "version": {
      "conventionalCommits": true
    }
  },
  "targetDefaults": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "inputs": ["default", "^default"],
      "dependsOn": ["lint-circular-dependencies", "^build", "^install-dependencies"],
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/oxlint.config.ts",
        { "externalDependencies": ["oxlint", "oxlint-tsgolint"] }
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "lint-circular-dependencies": {
      "cache": true
    },
    "install-dependencies": {
      "dependsOn": ["build"]
    },
    "test-storybook": {
      "outputs": ["{projectRoot}/test-reports/storybook"],
      "cache": true,
      "dependsOn": ["build"]
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/build.yml",
      "{workspaceRoot}/.github/actions/setup/action.yml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "analytics": false
}
